# ==================== 应用配置 ====================
# 运行环境: development | production | test | provision
# 默认值: development
NODE_ENV=development

# 应用端口 (0-65535)
# 默认值: 3000
PORT=8000

# ==================== 数据库配置 ====================
# PostgreSQL 数据库连接 URL（必填）
DATABASE_URL="postgresql://postgres:password@localhost:5432/yimei?schema=public"

# ==================== Redis 配置 ====================
# Redis 主机地址
# 默认值: localhost
REDIS_HOST=localhost

# Redis 端口
# 默认值: 6379
REDIS_PORT=6379

# Redis 密码（可选）
REDIS_PASSWORD=

# Redis 数据库索引
# 默认值: 0
REDIS_DB=0

# ==================== JWT 配置 ====================
# JWT 密钥（必填，至少 10 个字符）
# ⚠️ 生产环境务必修改此值！
JWT_SECRET="your-secret-key-change-this-in-production"

# JWT 过期时间
# 默认值: 7d
# 示例: 1h, 7d, 30d
JWT_EXPIRES_IN="7d"

# ==================== OSS/S3 配置 ====================
# S3 服务端点 URL（必填）
S3_ENDPOINT="http://127.0.0.1:9000"

# S3 存储桶名称（必填）
S3_BUCKET="yimei"

# AWS 区域
# 默认值: us-east-1
AWS_REGION="us-east-1"

# AWS 访问密钥 ID（必填）
AWS_ACCESS_KEY_ID="rustfsadmin"

# AWS 访问密钥密码（必填）
AWS_SECRET_ACCESS_KEY="rustfsadmin"

# ==================== AI 图像生成配置 ====================
# Stability AI API 配置（可选）
# 注册地址: https://platform.stability.ai
STABILITY_API_KEY=""
STABILITY_BASE_URL="https://api.stability.ai"

# OpenAI API 配置（可选）
# 注册地址: https://platform.openai.com
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"

# 阿里云通义万相配置（可选）
# 注册地址: https://dashscope.aliyun.com
ALIYUN_API_KEY=""
ALIYUN_BASE_URL="https://dashscope.aliyuncs.com/api/v1"